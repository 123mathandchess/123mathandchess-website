      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/author/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/feed/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/",
      "permanent": false
